# OpenAnonymizer API configuration. Copy to .env and fill in. Never commit .env.
# Generate keys with:
#   python -c "import secrets; print('anonymizer_' + secrets.token_urlsafe(32))"
#   python -c "from anonymizer.vault import VaultKey; print(VaultKey.generate().to_b64())"

# First dashboard admin. Only used while no user exists; change the password
# after the first login (Settings). Alternative: `anonymizer user create`.
ANONYMIZER_BOOTSTRAP_ADMIN_EMAIL=
ANONYMIZER_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: keys for scan/classify/anonymize/protect (comma-separated, min. 24 chars).
# Keys can also be created in the dashboard (API Keys). Env keys belong to the
# default organization.
ANONYMIZER_API_KEYS=

# Optional: separate keys for /v1/restore and policy management.
# Without any admin key those endpoints are disabled.
ANONYMIZER_ADMIN_KEYS=

# Optional: enables reversible pseudonymization (vault). Keep a backup of
# this key outside the server: without it the vault cannot be decrypted.
ANONYMIZER_VAULT_KEY=

# Optional
# ANONYMIZER_DEFAULT_POLICY=banking-default
# ANONYMIZER_MAX_CHARS=200000
# ANONYMIZER_ENABLE_NER=1
# German NER model. Default: plain de_core_news_lg. Fine-tuned weights shipped in this repository:
#   legal texts (court decisions, pleadings):  de_core_news_lg+models/de_legal_ner/ner
#   support mails and chats:                   de_core_news_lg+models/de_c24_ner/ner
# ANONYMIZER_NER_MODEL_DE=de_core_news_lg+models/de_legal_ner/ner
# Policy for API and MCP (built in: banking-default, support-default, legal-default)
# ANONYMIZER_DEFAULT_POLICY=legal-default

# Traces (metadata only), accounts and audit log, see docs/accounts.md
# ANONYMIZER_TRACE_DB=/data/traces.db
# ANONYMIZER_TRACE_RETENTION_DAYS=30
# ANONYMIZER_ACCOUNTS_DB=/data/accounts.db
# ANONYMIZER_AUDIT_DB=/data/audit.db
# ANONYMIZER_SESSION_HOURS=12

# Dashboard (Next.js, e.g. on Vercel). Without ANONYMIZER_API_URL it runs in demo
# mode with example data. With it, users sign in with their OpenAnonymizer account; the
# session token stays in an httpOnly cookie.
# ANONYMIZER_API_URL=https://anonymizer-api.example.com
# Optional: URL shown in the integration snippets (default: ANONYMIZER_API_URL)
# ANONYMIZER_PUBLIC_API_URL=

# Deployment-specific patterns (order numbers, customer ids, ...), see docs/detection.md
# ANONYMIZER_CUSTOM_PATTERNS=/examples/patterns.yaml

# Playground (CSV uploads in the dashboard, MCP tools list_datasets / query_dataset)
# ANONYMIZER_PLAYGROUND_DB=/data/playground.db
# ANONYMIZER_PLAYGROUND_POLICY=support-default

# MCP for Claude Code, Cursor & co. over HTTP at /mcp (bearer: a OpenAnonymizer API key), see docs/mcp.md
# ANONYMIZER_MCP_HTTP=1
# ANONYMIZER_MCP_ALLOWED_HOSTS=anonymizer.internal.example   # optional DNS-rebinding protection
