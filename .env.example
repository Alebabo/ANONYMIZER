# Cato API configuration. Copy to .env and fill in. Never commit .env.
# Generate keys with:
#   python -c "import secrets; print('cato_' + secrets.token_urlsafe(32))"
#   python -c "from cato.vault import VaultKey; print(VaultKey.generate().to_b64())"

# First dashboard admin. Only used while no user exists; change the password
# after the first login (Settings). Alternative: `cato user create`.
CATO_BOOTSTRAP_ADMIN_EMAIL=
CATO_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: keys for scan/classify/anonymize/protect (comma-separated, min. 24 chars).
# Keys can also be created in the dashboard (API Keys). Env keys belong to the
# default organization.
CATO_API_KEYS=

# Optional: separate keys for /v1/restore and policy management.
# Without any admin key those endpoints are disabled.
CATO_ADMIN_KEYS=

# Optional: enables reversible pseudonymization (vault). Keep a backup of
# this key outside the server: without it the vault cannot be decrypted.
CATO_VAULT_KEY=

# Optional
# CATO_DEFAULT_POLICY=legal-default
# CATO_MAX_CHARS=200000
# CATO_ENABLE_NER=1

# Gateway (OpenAI-compatible /v1/chat/completions), see docs/gateway.md
# CATO_UPSTREAM_URL=https://api.openai.com/v1
# CATO_UPSTREAM_KEY=
# CATO_UPSTREAM_PROVIDER=openai
# Optional local model for content the policy keeps local (e.g. Ollama)
# CATO_LOCAL_UPSTREAM_URL=http://ollama:11434/v1
# CATO_LOCAL_MODEL=llama3.1

# Traces (metadata only), accounts and audit log, see docs/accounts.md
# CATO_TRACE_DB=/data/traces.db
# CATO_TRACE_RETENTION_DAYS=30
# CATO_ACCOUNTS_DB=/data/accounts.db
# CATO_AUDIT_DB=/data/audit.db
# CATO_SESSION_HOURS=12

# Dashboard (Next.js, e.g. on Vercel). Without CATO_API_URL it runs in demo
# mode with example data. With it, users sign in with their Cato account; the
# session token stays in an httpOnly cookie.
# CATO_API_URL=https://cato-api.example.com
# Optional: URL shown in the integration snippets (default: CATO_API_URL)
# CATO_PUBLIC_API_URL=
