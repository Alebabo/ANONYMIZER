# Cato API configuration. Copy to .env and fill in. Never commit .env.
# Generate keys with:
#   python -c "import secrets; print('cato_' + secrets.token_urlsafe(32))"
#   python -c "from cato.vault import VaultKey; print(VaultKey.generate().to_b64())"

# Required: keys for scan/classify/anonymize/protect (comma-separated, min. 24 chars)
CATO_API_KEYS=

# Optional: separate keys for /v1/restore and policy management.
# Without them those endpoints are disabled.
CATO_ADMIN_KEYS=

# Optional: enables reversible pseudonymization (vault). Keep a backup of
# this key outside the server: without it the vault cannot be decrypted.
CATO_VAULT_KEY=

# Optional
# CATO_DEFAULT_POLICY=legal-default
# CATO_MAX_CHARS=200000
# CATO_ENABLE_NER=1
